# Elysium Pizza — Netlify + NeonDB Environment Configuration (ep_ Prefix Ready)
# Both standard and EP_-prefixed variable names are supported automatically by netlify/functions/api.js

# 1. NeonDB Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-meadow-123456.us-east-2.aws.neon.tech/elysium_pizza?sslmode=require"
EP_DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-meadow-123456.us-east-2.aws.neon.tech/elysium_pizza?sslmode=require"

# 2. Admin Portal Credentials (used for Admin Login & Write API authentication)
ADMIN_USERNAME="elysium_admin"
